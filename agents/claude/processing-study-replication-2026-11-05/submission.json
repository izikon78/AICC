 "claims": {
  "supported": [
   "All four plans give identical outputs on the 3 stress jobs; signatures byte-identical to the original Windows run",
   "Ordinary flow optimisation (reference->static) cuts pipeline time 22.0-53.9% and peak memory 20.5-73.5% on these shapes",
   "AICC register+bind costs about 0.92 ms (median) per worker and does not change outputs; 9/9 binding-state checks pass",
   "Batching amortises per-call binding checks (AICC split/batch 28.8x; AICC batch = ordinary batch)"
  ],
  "contradicted": [
   "AICC adds a consistent speed benefit beyond the same ordinary code (signs flip across jobs, runs and machines; inside same-code noise)",
   "The learned selector improves on the strongest static policy (held-out: worse in 2 of 3 trainings, tied in 1; worse in 4-7 of 12 extrapolation cells)"
  ],
  "unresolved": [
   "AICC effects below about 10% (3 repetitions on a shared host are underpowered)",
   "Whether an out-of-domain guard makes learned selection worthwhile",
   "Any authoring, lifecycle or economic benefit",
   "Isolation/security beyond the in-process prototype"
  ]
 },
 "failures_and_exclusions": [
  "run-001 (identical arguments): sandbox terminated the background process tree after calibration, training, binding scenarios and 5/45 workers; no exit status; preserved unchanged and excluded from stress comparisons; its learning report is reported separately as a second training"
 ],
 "deviations_from_protocol": [
  "Python 3.12.3 vs 3.12.14; Linux vs Windows; 1 logical CPU vs 12; RSS high-water vs PeakWorkingSetSize",
  "Post-replication probes (extrapolation, batch checkpoints) use one warm process and list input, not the fresh-process stress protocol; designed after reading the original results, not preregistered"
 ],
 "limitations": [
  "Single-agent, same-session work; provider identity self-reported",
  "Public fixed seeds: remeasurement, not unseen-seed generalisation",
  "Three repetitions per cell support descriptive ranges only",
  "Pushed to branch claude/processing-study-replication at the owner's explicit request, overriding the packet's token guardrail; not merged"
 ],
 "next_experiment": {
  "hypothesis": "A guard that defers to the static policy for declared-ordered jobs or out-of-range sizes removes the learned selector's losses but does not beat static by more than its ~1 ms selection overhead",
  "baseline_and_candidate": "Unchanged strongest static policy vs learned+guard; identical kernels; ordinary invocation",
  "fresh_evaluation_design": "New preregistered seeds; sizes 800-2,000,000; >=30 fresh descriptors per size band; 10 randomised fresh-process repetitions per case on one exclusive host",
  "acceptance_and_falsification_rules": "Accept if paired median end-to-end time improves >=2% with bootstrap 95% CI excluding 0 and no size band regresses >2%; falsified if guarded choices never depart from static or departures do not save more than selection overhead"
 }
